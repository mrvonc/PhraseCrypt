<Window x:Class="PhraseCryptApp.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhraseCrypt" Height="560" Width="440"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <!-- Theme colors are injected at runtime by ThemeManager; see LauncherWindow.xaml.cs. -->

            <!-- ============ Large channel tile button ============ -->
            <Style x:Key="ChannelTileButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{DynamicResource PanelGradientBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="{TemplateBinding Padding}"
                                    Effect="{DynamicResource PanelShadow}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBgBrush}">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ Header ============ -->
            <StackPanel Grid.Row="0" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="10" Height="10" CornerRadius="5" Margin="0,3,10,0" VerticalAlignment="Top">
                        <Border.Background>
                            <RadialGradientBrush>
                                <GradientStop Color="#FFD27A" Offset="0"/>
                                <GradientStop Color="#F5A623" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#F5A623" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                        </Border.Effect>
                    </Border>

                    <TextBlock FontSize="32" FontWeight="Black" FontFamily="Segoe UI Semibold">
                        <Run Text="Phrase" Foreground="{DynamicResource TextPrimaryBrush}"/><Run Text="Crypt" Foreground="#F5A623"/>
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#F5A623" BlurRadius="14" ShadowDepth="0" Opacity="0.45"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
                <TextBlock x:Name="LauncherSubtitleText" Text="Choose your channel"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- ============ Channel tiles ============ -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <Button x:Name="StableButton" Style="{StaticResource ChannelTileButton}" Margin="0,0,0,16"
                        Click="StableButton_Click" MouseEnter="StableButton_MouseEnter">
                    <StackPanel>
                        <TextBlock x:Name="StableTitleText" Text="STABLE" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="StableSubtitleText" Text="Tested and approved" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>

                <Button x:Name="AlphaButton" Style="{StaticResource ChannelTileButton}"
                        Click="AlphaButton_Click" MouseEnter="AlphaButton_MouseEnter">
                    <StackPanel>
                        <TextBlock x:Name="AlphaTitleText" Text="ALPHA" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="AlphaSubtitleText" Text="Experimental features, untested" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ============ Footer: version + selected channel ============ -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,20,0,10">
                <TextBlock x:Name="VersionText" Text="Version 1.0.0" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ChannelSelectedText" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
