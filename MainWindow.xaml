<Window x:Class="PhraseCryptApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhraseCrypt" Height="820" Width="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        ResizeMode="CanResize"
        MinHeight="720" MinWidth="560">

    <Window.Resources>
        <ResourceDictionary>
            <!-- Theme colors (dark/light) are injected at runtime by ThemeManager into
                 Resources.MergedDictionaries; see MainWindow.xaml.cs. Every color
                 reference below therefore uses DynamicResource. -->

            <!-- Easing shared by all transitions (theme independent) -->
            <CubicEase x:Key="StdEaseOut" EasingMode="EaseOut"/>
            <CubicEase x:Key="StdEaseInOut" EasingMode="EaseInOut"/>

            <!-- ============ Segmented toggle (read / write) ============ -->
            <Style x:Key="SegmentToggle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="0,10"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#33F5A623"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ Text box ============ -->
            <Style x:Key="DarkTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource AccentDimBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ Accent button (hover scale + glow) ============ -->
            <Style x:Key="AccentButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="#0D0D0D"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="0,11"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!-- Effect goes on Bd, not on the outer Button. Otherwise the storyboard
                                 animation cannot resolve its target, which froze the UI. -->
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                                <Border.Effect>
                                    <DropShadowEffect Color="#F5A623" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/>
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Bd"
                                                                 Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                 To="#FFC157" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="Bd"
                                                                  Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                                  To="1.02" Duration="0:0:0.15" EasingFunction="{StaticResource StdEaseOut}"/>
                                                <DoubleAnimation Storyboard.TargetName="Bd"
                                                                  Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                                  To="1.02" Duration="0:0:0.15" EasingFunction="{StaticResource StdEaseOut}"/>
                                                <DoubleAnimation Storyboard.TargetName="Bd"
                                                                  Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                                                                  To="0.7" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Bd"
                                                                 Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                 To="#F5A623" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="Bd"
                                                                  Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                                  To="1.0" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="Bd"
                                                                  Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                                  To="1.0" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="Bd"
                                                                  Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                                                                  To="0.35" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#CC8419"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ Ghost button (copy / steganography) ============ -->
            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Theme-safe triggers instead of hard-coded color animations, so the
                                     hover state fits both dark and light automatically. -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="Bd" Property="Background" Value="#14F5A623"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ Password box ============ -->
            <Style x:Key="DarkPasswordBox" TargetType="PasswordBox">
                <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ Radio button (option lists) ============ -->
            <Style x:Key="DarkRadio" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,0,0,7"/>
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ============ Check box ============ -->
            <Style x:Key="DarkCheckBox" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,10,0,0"/>
            </Style>

            <!-- ============ ComboBoxItem style (appearance of dropdown entries) ============ -->
            <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemBd" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource AccentDimBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ Fully re-templated ComboBox (dropdown popup is themed too) ============ -->
            <Style x:Key="DarkComboBox" TargetType="ComboBox">
                <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="MainBorder" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"/>

                                <ToggleButton x:Name="ToggleBtn" Background="Transparent" BorderThickness="0"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              ClickMode="Press" Focusable="False"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="26"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z"
                                                      Fill="{DynamicResource TextSecondaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                                   Content="{TemplateBinding SelectionBoxItem}"
                                                   ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                   Margin="{TemplateBinding Padding}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                                   TextElement.Foreground="{TemplateBinding Foreground}"/>

                                <TextBox x:Name="PART_EditableTextBox"
                                         Visibility="Hidden"
                                         Background="Transparent"
                                         Foreground="{TemplateBinding Foreground}"
                                         CaretBrush="{DynamicResource AccentBrush}"
                                         BorderThickness="0"
                                         Margin="{TemplateBinding Padding}"
                                         VerticalAlignment="Center" HorizontalAlignment="Left"
                                         IsReadOnly="{TemplateBinding IsReadOnly}"
                                         Focusable="True">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent"/>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>

                                <Popup x:Name="Popup" Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                    <Border x:Name="DropDownBorder" Background="{DynamicResource DropdownBgBrush}"
                                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                                            CornerRadius="7" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            MaxHeight="240" Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="3" Opacity="0.4"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="3" SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEditable" Value="True">
                                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource PanelBorderHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Style>

            <!-- Reusable card style with depth -->
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource PanelGradientBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Effect" Value="{DynamicResource PanelShadow}"/>
            </Style>

            <!-- ============ Theme toggle switch (pill with sun/moon) ============ -->
            <Style x:Key="ThemeToggleSwitch" TargetType="ToggleButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Track" Width="52" Height="28" CornerRadius="14"
                                    Background="{DynamicResource PanelGradientBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <!-- Default state = dark mode active: moon, cool silver -->
                                    <Border x:Name="Knob" Width="22" Height="22" CornerRadius="11"
                                            HorizontalAlignment="Left" Margin="2,0,0,0"
                                            Background="#CBD2E0">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="KnobTransform" X="0"/>
                                        </Border.RenderTransform>
                                        <TextBlock x:Name="KnobIcon" Text="&#x263E;" FontSize="12" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Foreground="#1A1A1A"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="KnobTransform" Storyboard.TargetProperty="X"
                                                                  To="24" Duration="0:0:0.18" EasingFunction="{StaticResource StdEaseOut}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="KnobTransform" Storyboard.TargetProperty="X"
                                                                  To="0" Duration="0:0:0.18" EasingFunction="{StaticResource StdEaseOut}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                    <!-- Light mode active: sun, warm orange -->
                                    <Setter TargetName="KnobIcon" Property="Text" Value="&#x2600;"/>
                                    <Setter TargetName="Knob" Property="Background" Value="#F5A623"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Window.Triggers>
        <!-- Entrance animation: the whole content fades and slides gently into place -->
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootContent" Storyboard.TargetProperty="Opacity"
                                      From="0" To="1" Duration="0:0:0.5" EasingFunction="{StaticResource StdEaseOut}"/>
                    <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="Y"
                                      From="18" To="0" Duration="0:0:0.5" EasingFunction="{StaticResource StdEaseOut}"/>
                    <DoubleAnimation Storyboard.TargetName="AccentDotPulse" Storyboard.TargetProperty="Opacity"
                                      From="1" To="0.35" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever"
                                      BeginTime="0:0:0.5"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="{DynamicResource WindowBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid x:Name="RootContent" Margin="26" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTransform" Y="18"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="AccentDotPulse" Width="10" Height="10" CornerRadius="5" Margin="0,3,10,0" VerticalAlignment="Top">
                        <Border.Background>
                            <RadialGradientBrush>
                                <GradientStop Color="#FFD27A" Offset="0"/>
                                <GradientStop Color="#F5A623" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#F5A623" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                        </Border.Effect>
                    </Border>

                    <!-- Two-tone title with a soft glow -->
                    <TextBlock x:Name="AppTitleText" FontSize="32" FontWeight="Black" FontFamily="Segoe UI Semibold">
                        <Run Text="Phrase" Foreground="{DynamicResource TextPrimaryBrush}"/><Run Text="Crypt" Foreground="#F5A623"/>
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#F5A623" BlurRadius="14" ShadowDepth="0" Opacity="0.45"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
                <TextBlock x:Name="AppSubtitleText" Text="BIP39 Word ⇄ Hex Converter"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                           Margin="20,3,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,16,0">
                <TextBlock x:Name="ThemeLabelText" Text="THEME" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <ToggleButton x:Name="ThemeToggle" Style="{StaticResource ThemeToggleSwitch}"
                              IsChecked="False" Checked="ThemeToggle_Changed" Unchecked="ThemeToggle_Changed"/>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                <TextBlock x:Name="LanguageLabelText" Text="LANGUAGE" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Right" Margin="0,0,0,4"/>
                <ComboBox x:Name="LanguageCombo" Style="{StaticResource DarkComboBox}" Width="130" Padding="8,6"
                          SelectionChanged="LanguageCombo_SelectionChanged">
                    <ComboBoxItem Content="English" Tag="en" IsSelected="True"/>
                    <ComboBoxItem Content="Deutsch" Tag="de"/>
                    <ComboBoxItem Content="Русский" Tag="ru"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- ============ Mode Switch ============ -->
        <Border Grid.Row="1" Background="{DynamicResource PanelGradientBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="9" Padding="4" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="ModeWriteRadio" Grid.Column="0" Content="WRITE" Style="{StaticResource SegmentToggle}"
                             GroupName="Mode" IsChecked="True" Checked="ModeToggle_Checked"/>
                <RadioButton x:Name="ModeReadRadio" Grid.Column="1" Content="READ" Style="{StaticResource SegmentToggle}"
                             GroupName="Mode" Checked="ModeToggle_Checked"/>
            </Grid>
        </Border>

        <!-- ============ Input panel ============ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,16">
            <Grid>

                <!-- WRITE mode input.
                     The generated phrase is ALWAYS standards-compliant BIP39 and is
                     NEVER shown here - only an encrypted container leaves this panel. -->
                <StackPanel x:Name="WritePanel">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="WritePanelTransform" Y="0"/>
                    </StackPanel.RenderTransform>

                    <TextBlock x:Name="WordCountLabel" Text="WORD COUNT" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <!-- Not editable on purpose: free-text input is an injection surface. -->
                    <ComboBox x:Name="WordCountCombo" Style="{StaticResource DarkComboBox}" IsEditable="False" SelectedIndex="0">
                        <ComboBoxItem Content="12"/>
                        <ComboBoxItem Content="24"/>
                    </ComboBox>

                    <Separator Margin="0,16,0,12" Background="{DynamicResource PanelBorderBrush}"/>

                    <TextBlock x:Name="ProtectionLabel" Text="PROTECTION (REQUIRED)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <RadioButton x:Name="ProtectAesRadio" GroupName="Protection" IsChecked="True"
                                 Content="AES-256-GCM (reports a wrong password)"
                                 Style="{StaticResource DarkRadio}"/>
                    <RadioButton x:Name="ProtectHoneyRadio" GroupName="Protection"
                                 Content="Honey Encryption (a wrong password yields a decoy phrase)"
                                 Style="{StaticResource DarkRadio}"/>

                    <TextBlock x:Name="PasswordLabel" Text="PASSWORD" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,6"/>
                    <PasswordBox x:Name="WritePasswordBox" Style="{StaticResource DarkPasswordBox}"/>

                    <TextBlock x:Name="PasswordConfirmLabel" Text="CONFIRM PASSWORD" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,6"/>
                    <PasswordBox x:Name="WritePasswordConfirmBox" Style="{StaticResource DarkPasswordBox}"/>

                    <TextBlock x:Name="WriteHintText" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0"
                               Text="The phrase is never displayed here. Store the container, then use READ with your password to reveal it."/>

                    <Button x:Name="GenerateButton" Content="GENERATE CONTAINER" Style="{StaticResource AccentButton}"
                            Margin="0,18,0,0" Click="GenerateButton_Click"/>
                </StackPanel>

                <!-- READ mode input.
                     This is the ONLY place where a phrase is ever shown in clear text. -->
                <StackPanel x:Name="ReadPanel" Visibility="Collapsed" Opacity="0">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="ReadPanelTransform" Y="0"/>
                    </StackPanel.RenderTransform>

                    <TextBlock x:Name="ReadModeLabel" Text="INPUT TYPE" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <RadioButton x:Name="ReadAesRadio" GroupName="ReadMode" IsChecked="True"
                                 Content="AES container" Style="{StaticResource DarkRadio}"
                                 Checked="ReadModeRadio_Changed"/>
                    <RadioButton x:Name="ReadHoneyRadio" GroupName="ReadMode"
                                 Content="Honey container" Style="{StaticResource DarkRadio}"
                                 Checked="ReadModeRadio_Changed"/>
                    <RadioButton x:Name="ReadValidateRadio" GroupName="ReadMode"
                                 Content="Validate a mnemonic phrase" Style="{StaticResource DarkRadio}"
                                 Checked="ReadModeRadio_Changed"/>

                    <TextBlock x:Name="ReadInputLabel" Text="CONTAINER (BASE64)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,6"/>
                    <TextBox x:Name="ContainerInputBox" Style="{StaticResource DarkTextBox}" Height="80"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                    <TextBlock x:Name="ReadPasswordLabel" Text="PASSWORD" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,6"/>
                    <PasswordBox x:Name="ReadPasswordBox" Style="{StaticResource DarkPasswordBox}"/>

                    <Button x:Name="DecodeButton" Content="REVEAL" Style="{StaticResource AccentButton}"
                            Margin="0,18,0,0" Click="DecodeButton_Click"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ============ Output panel ============ -->
        <Border x:Name="OutputPanelBorder" Grid.Row="3" Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="OutputLabel" Text="OUTPUT" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="ClearButton" Content="Clear" Style="{StaticResource GhostButton}"
                            Margin="0,0,6,0" Click="ClearButton_Click"/>
                    <Button Grid.Column="2" x:Name="CopyButton" Content="Copy" Style="{StaticResource GhostButton}" Click="CopyButton_Click"/>
                </Grid>

                <!-- Shown only while clear-text secrets are on screen (READ mode). -->
                <Border x:Name="SensitiveBanner" Grid.Row="1" Visibility="Collapsed"
                        Background="#22E0524B" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10,7" Margin="0,0,0,8">
                    <TextBlock x:Name="SensitiveBannerText" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource ErrorBrush}"
                               Text="Secret on screen. Copying and image embedding are disabled. Press Clear when done."/>
                </Border>

                <TextBox Grid.Row="2" x:Name="OutputBox" Style="{StaticResource DarkTextBox}"
                          IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                          VerticalScrollBarVisibility="Auto" MinHeight="160"/>
            </Grid>
        </Border>

        <!-- ============ Steganography ============ -->
        <Grid Grid.Row="4" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="HideInImageButton" Content="Hide in image..."
                    Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="HideInImageButton_Click"/>
            <Button Grid.Column="1" x:Name="ExtractFromImageButton" Content="Extract from image..."
                    Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="ExtractFromImageButton_Click"/>
        </Grid>

        <!-- ============ Status bar ============ -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="StatusDot" Grid.Column="0" Width="6" Height="6" CornerRadius="3"
                    Background="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Grid.Column="1" Text="Ready." Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        </Grid>

    </Grid>
    </ScrollViewer>
    </Border>
</Window>
